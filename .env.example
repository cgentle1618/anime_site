# =============================================================================
# CG1618 Media Tracker — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. All variables are read centrally in config.py.
# Values shown are the development defaults used when a variable is unset.
# =============================================================================

# --- Database (local development) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=anime_site_db

# Optional full connection string. When set it is used verbatim and overrides
# every POSTGRES_* value above, localhost included. Leave unset for local dev.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth / JWT ---
# REQUIRED in production. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=fallback_dev_secret_key_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Seeded admin password on first startup. REQUIRED (non-default) in production.
ADMIN_PASSWORD=admin123

# --- External metadata APIs ---
# TMDB: cover / release / director (free at themoviedb.org)
TMDB_API_KEY=
# OMDb: IMDb rating (free at omdbapi.com)
OMDB_API_KEY=
# Comic Vine: comic run metadata + cover (free, shown at comicvine.gamespot.com/api/
# once signed in to a GameSpot account)
COMICVINE_API_KEY=
# IGDB: game metadata, cover, genres, companies, time-to-beat.
# Free: register an application at dev.twitch.tv/console/apps - IGDB
# authenticates with Twitch client credentials, not an IGDB-specific key.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam: game prices (US/JP/TW), Metacritic critic score, achievements.
# The store half needs NO key. These two are only for personal playtime and
# achievements earned: key from steamcommunity.com/dev/apikey, and STEAM_ID is
# your 64-bit id. The profile's game details must be public.
STEAM_API_KEY=
STEAM_ID=
# Set to false to silence Steam entirely - no storefront call, no Web API
# call, no connection attempted. Useful on a network that inspects Steam
# traffic, where the Web API key above would travel in a readable URL.
# Defaults to true when unset; every other integration is unaffected.
STEAM_ENABLED=true

# --- Google Sheets (backup / restore) ---
# Service account JSON for the Sheets API, as a single-line string. Locally you
# may instead place a credentials.json file in the project root (gitignored).
GOOGLE_CREDENTIALS_JSON=
# Target spreadsheet ID.
GOOGLE_SHEET_ID=
