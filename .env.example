# =============================================================================
# CG1618 Media Tracker — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. In Cloud Run these are provided as service env vars /
# secrets instead. All variables are read centrally in config.py.
# Values shown are the development defaults used when a variable is unset.
# =============================================================================

# --- Database (local development) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=anime_site_db

# Cloud SQL unix socket (Cloud Run only). Leave unset locally.
# INSTANCE_CONNECTION_NAME=project:region:instance

# Optional external TCP connection string. Overrides the values above unless it
# points at localhost. Leave unset to use the local POSTGRES_* settings.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth / JWT ---
# REQUIRED in production. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=fallback_dev_secret_key_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Seeded admin password on first startup. REQUIRED (non-default) in production.
ADMIN_PASSWORD=admin123

# --- External metadata APIs ---
# TMDB: cover / release / director (free at themoviedb.org)
TMDB_API_KEY=
# OMDb: IMDb rating (free at omdbapi.com)
OMDB_API_KEY=
# Comic Vine: comic run metadata + cover (free, shown at comicvine.gamespot.com/api/
# once signed in to a GameSpot account)
COMICVINE_API_KEY=

# --- Google integrations ---
# Service account JSON as a single-line string. Locally you may instead place a
# credentials.json file in the project root (already gitignored).
GOOGLE_CREDENTIALS_JSON=
# Target Google Sheets spreadsheet ID (backup / restore).
GOOGLE_SHEET_ID=
# GCS bucket for cover images. Defaults to the internal prod bucket on Cloud Run.
GCP_BUCKET_NAME=

# --- Runtime ---
# K_SERVICE is set automatically by Cloud Run to signal production mode.
# Do NOT set it manually in local development.
# K_SERVICE=
