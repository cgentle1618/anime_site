# =============================================================================
# CG1618 Media Tracker — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. All variables are read centrally in config.py.
# Values shown are the development defaults used when a variable is unset.
#
# Two variables below are BLANK on purpose and the app refuses to start
# without them, in every environment. This file used to ship their example
# values live, which is how a machine ends up running on `admin123`.
# =============================================================================

# --- Runtime ---
# `development` or `production`. Unset means PRODUCTION, deliberately: the
# safe default is the one where forgetting it fails loudly on a dev machine
# (a Secure cookie over plain HTTP is dropped by the browser, so login stops
# working) rather than quietly on a public one. Set it on both dev machines.
APP_ENV=development

# --- Database (local development) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=anime_site_db

# Optional full connection string. When set it is used verbatim and overrides
# every POSTGRES_* value above, localhost included. Leave unset for local dev.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth / JWT ---
# REQUIRED, everywhere. The app refuses to start while either of the next two
# still holds the value this file used to ship. Generate the secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Seeds the master account on first startup. Pick a real password: it is the
# one protecting every admin route.
ADMIN_PASSWORD=

# --- External metadata APIs ---
# TMDB: cover / release / director (free at themoviedb.org)
TMDB_API_KEY=
# OMDb: IMDb rating (free at omdbapi.com)
OMDB_API_KEY=
# Comic Vine: comic run metadata + cover (free, shown at comicvine.gamespot.com/api/
# once signed in to a GameSpot account)
COMICVINE_API_KEY=
# IGDB: game metadata, cover, genres, companies, time-to-beat.
# Free: register an application at dev.twitch.tv/console/apps - IGDB
# authenticates with Twitch client credentials, not an IGDB-specific key.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam: game prices (US/JP/TW), Metacritic critic score, achievements.
# The store half needs NO key. These two are only for personal playtime and
# achievements earned: key from steamcommunity.com/dev/apikey, and STEAM_ID is
# your 64-bit id. The profile's game details must be public.
STEAM_API_KEY=
STEAM_ID=
# Set to false to silence Steam entirely - no storefront call, no Web API
# call, no connection attempted. Useful on a network that inspects Steam
# traffic, where the Web API key above would travel in a readable URL.
# Defaults to true when unset; every other integration is unaffected.
STEAM_ENABLED=true

# --- Google Sheets (backup / restore) ---
# Service account JSON for the Sheets API, as a single-line string. Locally you
# may instead place a credentials.json file in the project root (gitignored).
GOOGLE_CREDENTIALS_JSON=
# Target spreadsheet ID.
GOOGLE_SHEET_ID=

# Pins the docker-compose project name, and therefore the VOLUME name.
# Compose otherwise derives it from the project directory, so a git worktree
# mounts <worktree>_postgres_anime_data - a brand-new EMPTY database on the
# same port - and the app cheerfully creates the schema and seeds a fresh
# admin while the real data sits untouched in anime_site_postgres_anime_data.
# The primary checkout only survives without this because its directory
# happens to be named anime_site; that is a coincidence, not a setting.
COMPOSE_PROJECT_NAME=anime_site
